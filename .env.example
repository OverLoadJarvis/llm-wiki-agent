# LLM Wiki Agent Configuration
# =================================

# DeepSeek API 配置
# -----------------
# DeepSeek 提供 OpenAI 兼容的 API
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=your-api-key-here

# Model Configuration
# -------------------
# 核心任务使用的模型（ingest、query、lint）
# DeepSeek 推荐模型：deepseek-chat (33B) 或 deepseek-r1-chat (70B)
LLM_MODEL=deepseek-v4-flash

# 快速任务使用的模型（图构建、页面选择）
# DeepSeek 轻量模型：deepseek-chat (33B) 或 deepseek-coder
LLM_MODEL_FAST=deepseek-v4-flash

# litellm 配置
# ------------
# 启用详细日志（调试时使用）
# LITELLM_LOG=True